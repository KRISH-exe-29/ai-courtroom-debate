# Copy to .env.local and set ONE provider. With nothing set, an installed Claude Code or Codex is used.

# Claude API: Sonnet lawyers, Opus judge
# ANTHROPIC_API_KEY=

# Gemini API (OpenAI-compatible endpoint)
# GEMINI_API_KEY=

# Any OpenAI-compatible server: Ollama, Groq, OpenRouter, ...
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# LAWYER_MODEL=
# JUDGE_MODEL=

# Your coding agent, on your own login: claude-code or codex
# AGENT_CLI=claude-code
# AGENT_MODEL=sonnet
